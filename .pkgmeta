package-as: ClickLegend

# CurseForge shows this file as the release notes.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# Repository-only files that should not ship inside the addon.
ignore:
  - README.md
  - .github
  - .gitignore
  # Local only; listed so they cannot ship even if committed later.
  - CLAUDE.md
  - dev
  # The source art for the mouse picture; media/mouse.png is what ships.
  - mouse-files
  - .claude
  - .vscode
  - .idea
  - .pkgmeta
